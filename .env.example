# ==========================================
# LLM API Configuration
# ==========================================
# LLM Provider: "gemini" (default)
LLM_PROVIDER=gemini

# Gemini API Key (obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemini Flash model
LLM_MODEL=gemini-3.8-flash

# Generation Parameters
# LLM_MAX_OUTPUT_TOKENS is passed directly to Gemini GenerateContentConfig
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048

# Application-level Input Token Limit
# Enforced at application level via client.models.count_tokens() and context management.
# Not passed to GenerateContentConfig.
LLM_MAX_INPUT_TOKENS=8000

# Frequency penalty (0.0 default; applied only if supported by model and > 0.0)
LLM_FREQUENCY_PENALTY=0.0

# Optional: OpenAI API Key (if switching provider in future)
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# Vector DB & Retrieval Settings
# ==========================================
FAISS_INDEX_DIR=./faiss_index
MAX_RETRIEVED_DOCS=5

# ==========================================
# Agent Configuration
# ==========================================
MAX_TOOL_CALLS=5
