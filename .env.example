# LLM API Configuration (Choose your provider, e.g., Google Gemini or OpenAI)
# Gemini API Key (Free tier available from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Vector DB Settings
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Agent Configuration
MAX_TOOL_CALLS=5
MAX_RETRIEVED_DOCS=5
LLM_TEMPERATURE=0.1
